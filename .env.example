# xAI API key (https://console.x.ai). Can also be pasted in the app's Settings dialog.
XAI_API_KEY=

# Where generations, uploads and the job database are stored.
# DATA_DIR=./data

# Server bind address. Keep 127.0.0.1 unless you set APP_PASSWORD:
# anyone who can reach the server can spend your xAI credits.
# HOST=127.0.0.1
# PORT=8787
# APP_PASSWORD=

# Model used by the "Enhance prompt" button.
# XAI_TEXT_MODEL=grok-4.3

# Set to 1 to fake every xAI call (no key, no cost) - same as `npm run dev:mock`.
# XAI_MOCK=0
