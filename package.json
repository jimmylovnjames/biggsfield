{
  "name": "biggsfield",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Higgsfield-style studio for xAI Grok Imagine (image + video).",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"tsx watch server/index.ts\" \"vite\"",
    "dev:mock": "concurrently -k -n api,web -c green,cyan \"tsx watch server/index.ts --mock\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "start:mock": "tsx server/index.ts --mock",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test server/payloads.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
